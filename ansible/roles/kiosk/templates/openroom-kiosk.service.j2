{{ ansible_managed | comment }}
# Replaces getty on tty1 with a Wayland kiosk session: cage running a single
# fullscreen Chromium instance. Using a dedicated service (rather than
# autologin + shell profile) keeps the session declarative and lets the
# watchdog (added in a later milestone) manage it like any other unit.
[Unit]
Description=OpenRoom kiosk session
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User={{ kiosk_user }}
Group={{ kiosk_group }}
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=2
ExecStart=/usr/bin/cage -- /usr/bin/chromium --kiosk --ozone-platform=wayland --enable-features=UseOzonePlatform --noerrdialogs --disable-infobars --disable-session-crashed-bubble --no-first-run --start-fullscreen --user-data-dir={{ kiosk_home }}/.chromium{% for flag in chromium_extra_flags %} {{ flag }}{% endfor %} {{ kiosk_start_url }}

[Install]
WantedBy=multi-user.target
