# {{ ansible_managed }}
#
# Stable symlink for the room camera by USB vendor/product ID, plus a
# trigger to (re)apply v4l2-ctl settings on boot (coldplug) and hot-plug.
# ATTR{index}=="0" restricts the match to the primary capture node on
# cameras that expose more than one /dev/video* node (e.g. a separate
# metadata node) — verify this is the right node on the real hardware.
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="{{ av_camera_vendor_id }}", ATTRS{idProduct}=="{{ av_camera_product_id }}", ATTR{index}=="0", SYMLINK+="openroom-camera", TAG+="systemd", ENV{SYSTEMD_WANTS}+="openroom-av.service"
