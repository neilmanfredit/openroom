{{ ansible_managed | comment }}
[Unit]
Description=OpenRoom control service
After=network.target

[Service]
Type=simple
User=openroom-control
Group=openroom-control
WorkingDirectory=/opt/openroom/control
EnvironmentFile=/etc/openroom/control.env
ExecStart=/opt/openroom/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
