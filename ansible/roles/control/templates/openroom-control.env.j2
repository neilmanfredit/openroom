# {{ ansible_managed }}
OPENROOM_ROOM_NAME={{ room_name }}
OPENROOM_HOME_URL={{ kiosk_start_url }}
OPENROOM_JOIN_BY_ID_URL={{ control_join_by_id_url }}
OPENROOM_EXTERNAL_BASE_URL={{ control_external_base_url }}
OPENROOM_CDP_HOST=127.0.0.1
OPENROOM_CDP_PORT=9222
OPENROOM_EXTENSION_CRX_PATH=/opt/openroom/extension/src.crx
OPENROOM_EXTENSION_ID_PATH=/opt/openroom/extension/id.txt
OPENROOM_EXTENSION_VERSION={{ control_extension_version }}

# --- Calendar (Milestone 4) ---
# Left blank (calendar polling disabled) until the room's app
# registration exists — see docs/M365-SETUP.md.
OPENROOM_GRAPH_TENANT_ID={{ graph_tenant_id }}
OPENROOM_GRAPH_CLIENT_ID={{ graph_client_id }}
OPENROOM_ROOM_MAILBOX_UPN={{ room_mailbox_upn }}
OPENROOM_GRAPH_CERT_PATH=/etc/openroom/graph/cert.pem
OPENROOM_GRAPH_KEY_PATH=/etc/openroom/graph/key.pem
OPENROOM_SHOW_MEETING_SUBJECT={{ show_meeting_subject | lower }}
OPENROOM_CALENDAR_POLL_INTERVAL_SECONDS={{ calendar_poll_interval_seconds }}
OPENROOM_CALENDAR_TIMEZONE={{ calendar_timezone }}
OPENROOM_CALENDAR_CACHE_PATH=/opt/openroom/state/calendar-cache.json

# --- Resilience (Milestone 5) ---
OPENROOM_RESILIENCE_POLL_INTERVAL_SECONDS={{ resilience_poll_interval_seconds }}
OPENROOM_MEETING_ENDED_GRACE_MINUTES={{ meeting_ended_grace_minutes }}
