#!/usr/bin/env bash
# OpenRoom watchdog: run periodically (every ~20s, via
# openroom-watchdog.timer). Restarts the kiosk after ~3 consecutive
# unhealthy checks (~60s of sustained failure, not a single blip), then
# reboots if that's needed 3 times within a 10-minute window.
set -euo pipefail

STATE_DIR=/run/openroom
FAIL_COUNT_FILE="$STATE_DIR/watchdog-fail-count"
RESTART_LOG_FILE="$STATE_DIR/watchdog-restart-log"

RESTART_THRESHOLD=3
REBOOT_THRESHOLD=3
REBOOT_WINDOW_SECONDS=600

mkdir -p "$STATE_DIR"

healthy() {
    curl -fsS --max-time 5 http://127.0.0.1:8080/health >/dev/null 2>&1 || return 1
    curl -fsS --max-time 5 http://127.0.0.1:9222/json/version >/dev/null 2>&1 || return 1
    return 0
}

if healthy; then
    echo 0 >"$FAIL_COUNT_FILE"
    exit 0
fi

fail_count=$(cat "$FAIL_COUNT_FILE" 2>/dev/null || echo 0)
fail_count=$((fail_count + 1))
echo "$fail_count" >"$FAIL_COUNT_FILE"

if [ "$fail_count" -lt "$RESTART_THRESHOLD" ]; then
    exit 0
fi

echo 0 >"$FAIL_COUNT_FILE"
logger -t openroom-watchdog "control service/Chromium unhealthy for ~60s; restarting openroom-kiosk.service"
systemctl restart openroom-kiosk.service

now=$(date +%s)
echo "$now" >>"$RESTART_LOG_FILE"

cutoff=$((now - REBOOT_WINDOW_SECONDS))
recent=$(awk -v cutoff="$cutoff" '$1 >= cutoff' "$RESTART_LOG_FILE" | wc -l)

if [ "$recent" -ge "$REBOOT_THRESHOLD" ]; then
    logger -t openroom-watchdog "$recent kiosk restarts within ${REBOOT_WINDOW_SECONDS}s; rebooting"
    rm -f "$RESTART_LOG_FILE"
    systemctl reboot
fi
